<div id="<%= dom_id(essay, :content) %>">
  <% if essay.content.present? %>
    <article class="max-w-2xl mx-auto px-5 py-10 prose prose-zinc dark:prose-invert prose-base leading-relaxed break-words">
      <header class="not-prose mb-10">
        <h1 class="text-2xl font-bold tracking-tight"><%= essay.title.presence || "Untitled" %></h1>
        <% if essay.author_name.present? %>
          <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
            <% if essay.author_id? %>
              <%= link_to essay.author_name, author_path(essay.author_id),
                  class: "hover:underline underline-offset-2" %>
            <% else %>
              <%= essay.author_name %>
            <% end %>
          </p>
        <% end %>
        <% if essay.estimated_minutes %>
          <p class="mt-1 text-xs text-zinc-400"><%= essay.estimated_minutes %> min read</p>
        <% end %>
      </header>

      <%= raw essay.content %>
    </article>
  <% else %>
    <div class="flex flex-col items-center justify-center h-64 gap-3 text-zinc-400 text-sm">
      <svg class="animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
      </svg>
      <span>Importing&hellip;</span>
    </div>
  <% end %>
</div>
