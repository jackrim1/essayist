<% content_for :title, "Upload Essay" %>

<div class="min-h-screen flex flex-col">
  <header class="sticky top-0 z-10 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 h-14 flex items-center gap-3">
      <%= link_to essays_path, class: "p-1.5 -ml-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <% end %>
      <span class="font-medium">Upload Essay</span>
    </div>
  </header>

  <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-10">
    <%= form_with model: @essay, class: "space-y-5" do |f| %>
      <% if @essay.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 dark:bg-red-900/20 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">
          <%= @essay.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="space-y-1.5">
        <%= f.label :title, class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
        <%= f.text_field :title,
            class: "block w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-100",
            placeholder: "Title" %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :author, class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
        <%= f.text_field :author,
            class: "block w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-100",
            placeholder: "Author (optional)" %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :original_file, "PDF File", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
        <div class="relative rounded-lg border-2 border-dashed border-zinc-200 dark:border-zinc-700 px-6 py-10 text-center hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors">
          <%= f.file_field :original_file, accept: "application/pdf",
              class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer" %>
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-zinc-300 dark:text-zinc-600 mb-3"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/></svg>
          <p class="text-sm text-zinc-500">Drop a PDF or tap to browse</p>
        </div>
      </div>

      <%= f.submit "Upload",
          class: "w-full py-2.5 rounded-xl font-medium text-sm bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:opacity-80 transition-opacity cursor-pointer" %>
    <% end %>
  </main>
</div>
