<% content_for :title, @essay.title %>

<div class="min-h-screen flex flex-col"
     data-controller="reader-settings"
     data-reader-settings-sync-url-value="<%= preferences_path %>">

  <!-- Sticky reader header -->
  <header class="sticky top-0 z-20 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 h-12 flex items-center gap-3">
      <%= link_to essays_path,
          class: "p-1.5 -ml-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <% end %>

      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate"><%= @essay.title.presence || "Untitled" %></p>
      </div>

      <%= link_to edit_essay_path(@essay),
          class: "p-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
      <% end %>
      <button data-action="reader-settings#openDrawer"
              class="p-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
      </button>
    </div>

    <!-- Reading progress bar -->
    <div class="h-0.5 bg-zinc-100 dark:bg-zinc-900">
      <div id="reading-progress"
           class="h-full bg-zinc-900 dark:bg-zinc-100 transition-all duration-300"
           style="width: <%= (@essay.last_read_position * 100).round(1) %>%"></div>
    </div>
  </header>

  <!-- Reader body: scroll tracking + highlight engine -->
  <main id="reader-content"
        class="flex-1 overflow-y-auto"
        data-controller="scroll-position highlight"
        data-scroll-position-save-url-value="<%= essay_position_path(@essay) %>"
        data-scroll-position-position-value="<%= @essay.last_read_position %>"
        data-highlight-create-url-value="<%= essay_highlights_path(@essay) %>"
        data-highlight-essay-id-value="<%= @essay.id %>"
        data-highlight-highlights-value="<%= @highlights.map { |h| { id: h.id, color: h.color, anchor: h.anchor } }.to_json %>"
        data-reader-settings-target="content">

    <% if @duplicates.any? %>
      <div class="max-w-2xl mx-auto px-5 pt-6">
        <div class="rounded-lg border border-amber-200 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-800 px-4 py-3 text-sm text-amber-700 dark:text-amber-400">
          <span class="font-medium">Possible duplicate</span> —
          <% @duplicates.each_with_index do |dup, i| %>
            <%= link_to(dup.title.presence || "Untitled", essay_path(dup), class: "underline underline-offset-2") %><% unless i == @duplicates.size - 1 %>, <% end %>
          <% end %>
          may contain the same essay.
        </div>
      </div>
    <% end %>

    <% if @essay.content.present? %>
      <article class="max-w-2xl mx-auto px-5 py-10 prose prose-zinc dark:prose-invert prose-base leading-relaxed break-words">
        <header class="not-prose mb-10">
          <h1 class="text-2xl font-bold tracking-tight"><%= @essay.title.presence || "Untitled" %></h1>
          <% if @essay.author.present? %>
            <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400"><%= @essay.author %></p>
          <% end %>
          <% if @essay.estimated_minutes %>
            <p class="mt-1 text-xs text-zinc-400"><%= @essay.estimated_minutes %> min read</p>
          <% end %>
        </header>

        <%= raw @essay.content %>
      </article>
    <% else %>
      <div class="flex items-center justify-center h-64 text-zinc-400 text-sm">
        Extracting text… check back in a moment.
      </div>
    <% end %>

    <!-- Floating highlight toolbar (hidden by default) -->
    <div id="highlight-toolbar"
         data-highlight-target="toolbar"
         class="fixed z-50 hidden">
      <%= render "highlights/toolbar", essay: @essay %>
    </div>
  </main>

  <!-- Highlights sidebar — always rendered so turbo stream prepend has a target -->
  <aside class="max-w-2xl mx-auto w-full px-5 py-6 border-t border-zinc-100 dark:border-zinc-800">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-4">Highlights</h2>
    <ul id="highlights-list" class="space-y-3">
      <%= render @highlights %>
    </ul>
    <% unless @highlights.any? %>
      <p id="highlights-empty" class="text-sm text-zinc-400">Select text to save a highlight.</p>
    <% end %>
  </aside>

  <!-- Reader settings bottom drawer -->
  <%= render "shared/reader_drawer", essay: @essay %>
</div>
