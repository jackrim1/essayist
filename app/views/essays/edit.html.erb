<% content_for :title, "Edit Essay" %>

<div class="min-h-screen flex flex-col">
  <header class="sticky top-0 z-10 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 h-14 flex items-center gap-3">
      <%= link_to essay_path(@essay), class: "p-1.5 -ml-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <% end %>
      <span class="font-medium">Edit Essay</span>
    </div>
  </header>

  <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-10">
    <%= form_with model: @essay, class: "space-y-5" do |f| %>
      <% if @essay.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 dark:bg-red-900/20 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">
          <%= @essay.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="space-y-1.5">
        <%= f.label :title, class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
        <%= f.text_field :title,
            class: "block w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-100" %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :author, class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
        <%= f.text_field :author,
            class: "block w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-100" %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :view_mode, "Default view mode", class: "block text-sm font-medium text-zinc-700 dark:text-zinc-300" %>
        <%= f.select :view_mode,
            Essay.view_modes.keys.map { |m| [m.capitalize, m] },
            {},
            class: "block w-full rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-zinc-100" %>
      </div>

      <div class="flex gap-3 pt-2">
        <%= f.submit "Save changes",
            class: "flex-1 py-2.5 rounded-xl font-medium text-sm bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:opacity-80 transition-opacity cursor-pointer" %>
        <%= link_to "Cancel", essay_path(@essay),
            class: "flex-1 py-2.5 rounded-xl font-medium text-sm text-center border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors" %>
      </div>
    <% end %>

    <!-- Danger zone -->
    <div class="mt-10 pt-8 border-t border-zinc-100 dark:border-zinc-800">
      <p class="text-xs text-zinc-400 uppercase tracking-wider mb-3">Danger zone</p>
      <%= button_to essay_path(@essay), method: :delete,
          class: "text-sm text-red-500 hover:text-red-700 dark:hover:text-red-400 transition-colors",
          data: { turbo_confirm: "Delete \"#{@essay.title}\"? This cannot be undone." } do %>
        Delete essay
      <% end %>
    </div>
  </main>
</div>
