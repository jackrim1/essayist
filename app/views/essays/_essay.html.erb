<% show_author      = local_assigns.fetch(:show_author, true) %>
<% highlight_count = local_assigns.fetch(:highlight_count, 0) %>
<li id="<%= dom_id(essay) %>"
    class="group flex items-center justify-between px-3 py-3.5 rounded-lg hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors">

  <div class="flex-1 min-w-0">
    <%= link_to essay.title.presence || "Untitled", essay_path(essay),
        class: "font-medium truncate block hover:text-zinc-600 dark:hover:text-zinc-300" %>
    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5 truncate">
      <% if show_author && essay.author_name.present? %>
        <% if essay.author_id? %>
          <%= link_to essay.author_name, author_path(essay.author_id),
              class: "hover:text-zinc-900 dark:hover:text-zinc-100 hover:underline underline-offset-2" %>
        <% else %>
          <span><%= essay.author_name %></span>
        <% end %>
        ·
      <% end %>
      <% if essay.estimated_minutes %>
        <%= essay.estimated_minutes %> min read
        <% if essay.reading_percent > 0 %> · <%= essay.reading_percent %>% read<% end %>
      <% end %>
    </p>
  </div>

  <div class="ml-3 shrink-0 flex items-center gap-3">
    <!-- Bookmark icon + highlight count -->
    <span class="highlight-count flex items-center gap-1 text-xs <%= highlight_count > 0 ? 'text-zinc-500 dark:text-zinc-400' : 'text-zinc-300 dark:text-zinc-700' %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="<%= highlight_count > 0 ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"/></svg>
      <%= highlight_count %>
    </span>

    <!-- Progress ring indicator -->
    <% if essay.reading_percent > 0 %>
      <div class="relative">
        <svg class="w-8 h-8 -rotate-90" viewBox="0 0 32 32">
          <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor"
                  class="text-zinc-200 dark:text-zinc-800" stroke-width="3"/>
          <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor"
                  class="text-zinc-900 dark:text-zinc-100"
                  stroke-width="3"
                  stroke-dasharray="<%= (75.4 * essay.last_read_position).round(1) %> 75.4"
                  stroke-linecap="round"/>
        </svg>
      </div>
    <% end %>
  </div>
</li>
