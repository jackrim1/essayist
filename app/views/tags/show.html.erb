<% content_for :title, "##{@tag.name}" %>

<div class="min-h-screen flex flex-col">
  <header class="sticky top-0 z-20 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 h-12 flex items-center gap-3">
      <%= link_to essays_path,
          class: "p-1.5 -ml-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <% end %>
      <span class="text-sm font-medium">#<%= @tag.name %></span>
      <span class="text-xs text-zinc-400"><%= pluralize(@highlights.count, "highlight") %></span>
    </div>
  </header>

  <main class="max-w-2xl mx-auto w-full px-5 py-8 flex-1">
    <% if @highlights.empty? %>
      <p class="text-sm text-zinc-400">No highlights with this tag yet.</p>
    <% else %>
      <% @highlights.group_by(&:essay).each do |essay, highlights| %>
        <section class="mb-8">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 mb-3">
            <%= link_to essay.title, essay_path(essay),
                class: "hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors" %>
          </h2>
          <ul class="space-y-3">
            <% highlights.each do |highlight| %>
              <% color_bg = {
                "yellow" => "bg-yellow-50 border-yellow-200 dark:bg-yellow-900/20 dark:border-yellow-700",
                "green"  => "bg-green-50  border-green-200  dark:bg-green-900/20  dark:border-green-700",
                "blue"   => "bg-blue-50   border-blue-200   dark:bg-blue-900/20   dark:border-blue-700",
                "pink"   => "bg-pink-50   border-pink-200   dark:bg-pink-900/20   dark:border-pink-700",
                "purple" => "bg-purple-50 border-purple-200 dark:bg-purple-900/20 dark:border-purple-700",
              }[highlight.color] || "bg-zinc-50 border-zinc-200 dark:bg-zinc-900 dark:border-zinc-700" %>
              <li class="rounded-lg border p-3 <%= color_bg %>">
                <p class="text-sm leading-relaxed"><%= highlight.content %></p>
                <% other_tags = highlight.tags.reject { |t| t.id == @tag.id } %>
                <% if other_tags.any? %>
                  <div class="mt-2 flex flex-wrap gap-1">
                    <% other_tags.each do |t| %>
                      <%= link_to "##{t.name}", tag_path(t.name),
                          class: "text-xs px-1.5 py-0.5 rounded-md bg-white/60 dark:bg-zinc-800/60 text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 border border-zinc-200/60 dark:border-zinc-700/60 transition-colors" %>
                    <% end %>
                  </div>
                <% end %>
                <p class="mt-1 text-xs text-zinc-400">
                  <%= link_to essay.title, essay_path(essay), class: "hover:text-zinc-600 dark:hover:text-zinc-300" %>
                </p>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    <% end %>
  </main>
</div>
