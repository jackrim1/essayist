<% content_for :title, "Similar essays" %>

<div class="min-h-screen flex flex-col">
  <!-- Header -->
  <header class="sticky top-0 z-20 border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 h-12 flex items-center gap-3">
      <%= link_to essay_path(@essay),
          class: "p-1.5 -ml-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <% end %>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-medium truncate">
          <%= @recommendation.kind == "author" ? "More by this author" : "More on this subject" %>
        </p>
        <p class="text-xs text-zinc-400 truncate"><%= @essay.title.presence || "Untitled" %></p>
      </div>
    </div>
  </header>

  <!-- Content -->
  <main class="flex-1 max-w-2xl mx-auto w-full px-5 py-8">
    <%= turbo_stream_from @recommendation.turbo_stream_name %>

    <div id="recommendation-content">
      <%= render "recommendations/content", recommendation: @recommendation %>
    </div>
  </main>
</div>
