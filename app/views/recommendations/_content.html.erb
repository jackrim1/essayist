<% if recommendation.failed? %>
  <div class="rounded-lg border border-red-200 bg-red-50 dark:bg-red-900/20 dark:border-red-800 px-4 py-3 text-sm text-red-700 dark:text-red-400">
    <p class="font-medium">Something went wrong</p>
    <% if recommendation.error_message.present? %>
      <p class="mt-1 text-xs opacity-75"><%= recommendation.error_message %></p>
    <% end %>
  </div>

<% elsif recommendation.pending? || recommendation.generating? %>
  <div class="flex flex-col items-center justify-center py-24 gap-4 text-zinc-400">
    <svg class="animate-spin" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
    <p class="text-sm">Finding similar essays…</p>
  </div>

<% else %>
  <% if recommendation.verifying? %>
    <p class="text-xs text-zinc-400 mb-4">Verifying links…</p>
  <% end %>

  <ol class="space-y-6">
    <%= render partial: "recommendations/result",
               collection: recommendation.results.order(:position),
               as: :result %>
  </ol>
<% end %>
