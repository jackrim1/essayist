<% content_for :title, @author.name %>

<div class="min-h-screen flex flex-col">
  <!-- Header -->
  <header class="sticky top-0 z-10 pt-safe border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-sm">
    <div class="max-w-2xl mx-auto px-4 h-14 flex items-center gap-3">
      <%= link_to essays_path,
          class: "p-1.5 -ml-1.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <% end %>
      <div class="flex-1 min-w-0">
        <p class="font-semibold truncate"><%= @author.name %></p>
        <p class="text-xs text-zinc-400"><%= pluralize(@essays.size, "essay") %></p>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-8">
    <% if @essays.empty? %>
      <p class="text-sm text-zinc-400 text-center py-16">No essays yet.</p>
    <% else %>
      <ul class="space-y-px">
        <% @essays.each do |essay| %>
          <%= render "essays/essay", essay: essay, show_author: false %>
        <% end %>
      </ul>
    <% end %>
  </main>
</div>
