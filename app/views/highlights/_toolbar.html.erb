<%# Floating selection toolbar rendered inside the highlight Stimulus controller %>
<div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-xl px-3 py-2.5 flex items-center gap-2">
  <%= form_with url: essay_highlights_path(essay),
      data: { action: "submit->highlight#saveHighlight" } do |f| %>

    <%= f.hidden_field :content, data: { highlight_target: "selectedText" } %>
    <%= f.hidden_field :anchor,  data: { highlight_target: "anchorInput" } %>
    <%= f.hidden_field :color,   value: "yellow", data: { highlight_target: "colorInput" } %>

    <!-- Color swatches -->
    <% Highlight::COLORS.each do |color| %>
      <% swatch_classes = {
        "yellow" => "bg-yellow-300",
        "green"  => "bg-green-300",
        "blue"   => "bg-blue-300",
        "pink"   => "bg-pink-300",
        "purple" => "bg-purple-300",
      }[color] %>
      <button type="button"
              data-action="highlight#setColor"
              data-color="<%= color %>"
              class="w-5 h-5 rounded-full <%= swatch_classes %> ring-offset-1 ring-zinc-900 dark:ring-zinc-100 transition-all">
      </button>
    <% end %>

    <div class="w-px h-4 bg-zinc-200 dark:bg-zinc-700 mx-1"></div>

    <%= f.submit "Save",
        class: "text-xs font-medium px-2.5 py-1 rounded-md bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 hover:opacity-80 transition-opacity cursor-pointer" %>
  <% end %>
</div>
