<span id="mark_hl_tag_<%= highlight_tag.id %>"
      data-tag-name="<%= highlight_tag.tag.name %>"
      class="inline-flex items-center gap-0.5 text-[10px] px-1 py-px rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
  <%= link_to "##{highlight_tag.tag.name}", tag_path(highlight_tag.tag.name),
      class: "hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors" %>
  <%= link_to "×", highlight_highlight_tag_path(highlight, highlight_tag),
      data: { turbo_method: :delete },
      class: "ml-0.5 leading-none text-zinc-300 hover:text-zinc-500 dark:text-zinc-600 dark:hover:text-zinc-400 transition-colors" %>
</span>
